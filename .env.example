# ---------------------------------------------------------------------------
# SayPay environment variables. Copy to .env.local and fill in.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser. Nothing else is.
# ---------------------------------------------------------------------------

# Public URL of this deployment (no trailing slash). Used for magic links,
# auth redirects and Stripe return URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: shown on the Privacy and Terms pages so people can contact you.
NEXT_PUBLIC_CONTACT_EMAIL=

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# SERVER ONLY. Used for client magic-link actions, signed URLs and webhooks.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Storage bucket created by 001_init.sql
SUPABASE_STORAGE_BUCKET=quote-media

# Stripe — card payments via Stripe Connect (contractors connect their own
# accounts in Settings → Get paid). Leave empty to offer bank transfer only.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Recurring price for the SayPay Pro plan. Optional: the Pro plan and the
# free-quote limit only switch on when this is set.
STRIPE_PRICE_ID=price_...
# Optional platform fee on client deposits, in basis points (100 = 1%).
STRIPE_DEPOSIT_FEE_BPS=0

# Number of quotes a workspace can create before a subscription is required.
FREE_QUOTE_LIMIT=5

